# ─── Base de Datos (Supabase PostgreSQL) ───
# Session pooler (Supavisor) — para runtime y migraciones (IPv4-safe)
DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-1-us-east-1.pooler.supabase.com:5432/postgres?connection_limit=10
DIRECT_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-1-us-east-1.pooler.supabase.com:5432/postgres

# ─── Supabase ───
SUPABASE_URL="https://goxbelhcdmqeravbyuvr.supabase.co"
SUPABASE_SERVICE_KEY=eyJ...
SUPABASE_ANON_KEY=eyJ...

# ─── Auth (JWT) ───
JWT_SECRET=generate-with-openssl-rand-hex-64
JWT_REFRESH_SECRET=generate-with-openssl-rand-hex-64

# ─── Alegra (Facturación Electrónica) ───
ALEGRA_USER=email@example.com
ALEGRA_TOKEN=your-alegra-api-token

# ─── Redis (BullMQ Jobs) ───
REDIS_URL=redis://default:xxx@xxx.upstash.io:6379

# ─── Email (Resend — P1) ───
RESEND_API_KEY=re_xxx

# ─── Frontend (legacy Vite SPA — packages/frontend) ───
VITE_API_URL=http://localhost:3001
VITE_SUPABASE_URL="https://goxbelhcdmqeravbyuvr.supabase.co"
VITE_SUPABASE_ANON_KEY=eyJ...

# ─── Frontend (Next.js — packages/web) ───
NEXT_PUBLIC_API_URL=http://localhost:3001
API_INTERNAL_URL=http://localhost:3001
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL="https://goxbelhcdmqeravbyuvr.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Cloudflare Workers: configure JWT_SECRET there as a runtime secret using the
# exact same value as Railway. Never expose it with a NEXT_PUBLIC_ prefix.

# ─── API ───
CORS_ORIGIN=http://localhost:3000
PORT=3001

# ─── Seed (prisma/seed.ts) ───
SEED_ADMIN_PASSWORD=change-me
SEED_CLIENT_PASSWORD=change-me

# ─── OCR seed tooling (packages/api/prisma/seeds) ───
GROQ_API_KEY=your-groq-api-key

# ─── App ───
CORS_ORIGIN="http://localhost:3000"
PORT="3001"
VITE_API_URL="http://localhost:3001"
NODE_ENV="development"
# COLORTERM: not app config — false positive from a vendored, gitignored terminal-color lib.
COLORTERM=
