# Supabase project (dorella-dev). NEVER commit the real .env with these values.
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
# Service role key — bypasses RLS, required to read/write Storage objects server-side.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Bucket to scan/optimize.
BUCKET=products

# Optimization parameters.
MAX_DIMENSION=1200
WEBP_QUALITY=80
# Files at or under this size (in KB) are left untouched.
SIZE_THRESHOLD_KB=300

# Safety switch. true = report only, no upload, no delete. Must be explicitly set to
# "false" to actually upload optimized files.
DRY_RUN=true

# Where optimized files are uploaded when DRY_RUN=false. Originals are never
# overwritten or deleted by this script.
OUTPUT_PREFIX=products-optimized

# Batch/concurrency controls to avoid hammering the Storage API.
BATCH_SIZE=10
BATCH_DELAY_MS=500
MAX_RETRIES=3
