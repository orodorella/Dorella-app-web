generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  cliente
  admin
  comercial
  bodega
}

enum Tier {
  detal
  por_mayor
  gran_mayor
}

enum OrderStatus {
  pending
  confirmed
  preparado
  invoiced
  shipped
  delivered
  cancelled
}

enum RewardStatus {
  progressing
  achieved
  delivered
}

enum SensitiveUserChangeType {
  tier
  role
}

enum PaymentProvider {
  mercadopago
}

enum PaymentStatus {
  pending
  in_process
  approved
  rejected
  cancelled
  refunded
  charged_back
}

enum InventoryReservationStatus {
  active
  consumed
  released
}

model User {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email                 String    @unique @db.VarChar(255)
  passwordHash          String?   @map("password_hash") @db.VarChar(255)
  provider              String    @default("email") @db.VarChar(20)
  nombre                String    @db.VarChar(255)
  apellido              String    @db.VarChar(255)
  telefono              String?   @db.VarChar(20)
  empresa               String?   @db.VarChar(255)
  nit                   String?   @db.VarChar(20)
  direccion             String?
  ciudad                String?   @db.VarChar(100)
  departamento          String?   @db.VarChar(100)
  role                  Role      @default(cliente)
  tier                  Tier      @default(detal)
  tierChangedAt         DateTime? @map("tier_changed_at") @db.Timestamptz(3)
  tierChangedBy         String?   @map("tier_changed_by") @db.Uuid
  alegraContactId       String?   @map("alegra_contact_id") @db.VarChar(50)
  totalComprasAcumulado Decimal   @default(0) @map("total_compras_acumulado") @db.Decimal(15, 2)
  isActive              Boolean   @default(true) @map("is_active")
  deactivatedAt         DateTime? @map("deactivated_at") @db.Timestamptz(3)
  deactivatedBy         String?   @map("deactivated_by") @db.Uuid
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  orders                Order[]             @relation("OrderCustomer")
  manuallyCreatedOrders Order[]             @relation("OrderCreator")
  salesOrders           Order[]             @relation("OrderSeller")
  auditLogs             AuditLog[]
  productCosts          ProductCost[]
  commissionRules       CommissionRule[]
  commissionEntries     CommissionEntry[]
  commissionLiquidations CommissionLiquidation[]
  commissionAdjustments CommissionAdjustment[]
  paymentsMarkedPaid    Order[]             @relation("OrderPaymentMarkedPaidBy")
  tierChanges           TierChangeLog[]
  userRewards           UserReward[]
  refreshTokens         RefreshToken[]
  passwordResetTokens   PasswordResetToken[]
  requestedSensitiveChanges SensitiveUserChangeVerification[] @relation("SensitiveUserChangeRequester")
  targetedSensitiveChanges  SensitiveUserChangeVerification[] @relation("SensitiveUserChangeTarget")
  catalogos             Catalogo[]
  courseAccesses        UserCourseAccess[]
  videoProgresses       UserVideoProgress[]
  tierChangedByAdmin    User?               @relation("TierChanger", fields: [tierChangedBy], references: [id], map: "fk_users_tier_changed_by")
  tiersChanged          User[]              @relation("TierChanger")
  actedTierChanges      TierChangeLog[]     @relation("TierChangeActor")
  deliveredRewards      UserReward[]        @relation("RewardDeliverer")
  deactivatedByUser     User?               @relation("UserDeactivator", fields: [deactivatedBy], references: [id], onDelete: SetNull, map: "fk_users_deactivated_by")
  usersDeactivated      User[]              @relation("UserDeactivator")
  productsDeactivated   Product[]           @relation("ProductDeactivator")
  categoriesDeactivated Category[]          @relation("CategoryDeactivator")
  catalogosDeactivated  Catalogo[]          @relation("CatalogoDeactivator")

  @@index([tierChangedBy])
  @@index([deactivatedBy])
  @@map("users")
}

model Category {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nombre        String    @db.VarChar(255)
  slug          String    @unique @db.VarChar(255)
  descripcion   String?
  imagenUrl     String?   @map("imagen_url") @db.VarChar(500)
  orden         Int       @default(0)
  isActive      Boolean   @default(true) @map("is_active")
  deactivatedAt DateTime? @map("deactivated_at") @db.Timestamptz(3)
  deactivatedBy String?   @map("deactivated_by") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  products          Product[]
  deactivatedByUser User?     @relation("CategoryDeactivator", fields: [deactivatedBy], references: [id], onDelete: SetNull)

  @@index([deactivatedBy])
  @@map("categories")
}

model Product {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sku                 String    @unique @db.VarChar(50)
  nombre              String    @db.VarChar(255)
  descripcion         String?
  precioBase          Decimal   @map("precio_base") @db.Decimal(12, 2)
  categoryId          String    @map("category_id") @db.Uuid
  imagenes            Json      @default("[]")
  pesoGramos          Decimal?  @map("peso_gramos") @db.Decimal(8, 2)
  material            String?   @db.VarChar(100)
  referenciaProveedor String?   @map("referencia_proveedor") @db.VarChar(100)
  proveedor           String?   @db.VarChar(100)
  stock               Int       @default(0)
  stockMinimo         Int       @default(0) @map("stock_minimo")
  stockReservado      Int       @default(0) @map("stock_reservado")
  alegraItemId        String?   @map("alegra_item_id") @db.VarChar(50)
  isActive            Boolean   @default(true) @map("is_active")
  isFeatured          Boolean   @default(false) @map("is_featured")
  tags                String[]  @default([])
  deactivatedAt       DateTime? @map("deactivated_at") @db.Timestamptz(3)
  deactivatedBy       String?   @map("deactivated_by") @db.Uuid
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  category          Category           @relation(fields: [categoryId], references: [id])
  orderItems        OrderItem[]
  catalogoProductos CatalogoProducto[]
  costs             ProductCost[]
  lots              InventoryLot[]
  movements         InventoryMovement[]
  deactivatedByUser User?              @relation("ProductDeactivator", fields: [deactivatedBy], references: [id], onDelete: SetNull)

  @@index([categoryId])
  @@index([isActive, isFeatured])
  @@index([deactivatedBy])
  // NOTA: products_nombre_trgm_idx / products_sku_trgm_idx (GIN + pg_trgm) existen
  // solo en la migración 0004_product_search_trgm — no representados aquí porque
  // requieren preview features de Prisma no verificadas en este entorno. No borrar
  // sin también hacer DROP INDEX en una migración.
  @@map("products")
}

model Order {
  id                  String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderNumber         String      @unique @map("order_number") @db.VarChar(20)
  userId              String?     @map("user_id") @db.Uuid
  status              OrderStatus @default(pending)
  tierAtPurchase      Tier        @map("tier_at_purchase")
  descuentoAplicado   Decimal     @map("descuento_aplicado") @db.Decimal(5, 4)
  subtotal            Decimal     @db.Decimal(15, 2)
  total               Decimal     @db.Decimal(15, 2)
  direccionEnvio      Json        @map("direccion_envio")
  notas               String?
  compradorNombre     String      @map("comprador_nombre") @db.VarChar(255)
  compradorApellido   String      @map("comprador_apellido") @db.VarChar(255)
  compradorTelefono   String      @map("comprador_telefono") @db.VarChar(20)
  compradorEmail      String?     @map("comprador_email") @db.VarChar(255)
  origen              String      @default("tienda") @db.VarChar(20)
  createdByAdminId    String?     @map("created_by_admin_id") @db.Uuid
  sellerId            String?     @map("seller_id") @db.Uuid
  // Rol del vendedor al crear la orden: la comisión no depende de cambios de rol posteriores. NULL en órdenes anteriores.
  sellerRole          String?     @map("seller_role") @db.VarChar(20)
  alegraInvoiceId     String?     @map("alegra_invoice_id") @db.VarChar(50)
  alegraInvoiceStatus String?     @map("alegra_invoice_status") @db.VarChar(50)
  alegraSyncError     String?     @map("alegra_sync_error")
  alegraRetryCount    Int         @default(0) @map("alegra_retry_count")
  paymentProvider     PaymentProvider? @map("payment_provider")
  paymentStatus       PaymentStatus?   @map("payment_status")
  paymentPreferenceId String?          @unique @map("payment_preference_id") @db.VarChar(100)
  paymentId           String?          @unique @map("payment_id") @db.VarChar(100)
  paymentExternalReference String?     @unique @map("payment_external_reference") @db.VarChar(100)
  paymentInitPoint    String?          @map("payment_init_point") @db.VarChar(1000)
  paymentSandboxInitPoint String?      @map("payment_sandbox_init_point") @db.VarChar(1000)
  paidAt              DateTime?   @map("paid_at") @db.Timestamptz(3)
  paymentMarkedPaidBy String?     @map("payment_marked_paid_by") @db.Uuid
  purchaseCreditedAt  DateTime?   @map("purchase_credited_at") @db.Timestamptz(3)
  shippedAt           DateTime?   @map("shipped_at") @db.Timestamptz(3)
  deliveredAt         DateTime?   @map("delivered_at") @db.Timestamptz(3)
  createdAt           DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  user           User?              @relation("OrderCustomer", fields: [userId], references: [id])
  createdByAdmin User?              @relation("OrderCreator", fields: [createdByAdminId], references: [id], onDelete: SetNull)
  seller         User?              @relation("OrderSeller", fields: [sellerId], references: [id], onDelete: SetNull)
  paymentMarkedPaidByAdmin User?    @relation("OrderPaymentMarkedPaidBy", fields: [paymentMarkedPaidBy], references: [id], onDelete: SetNull)
  items          OrderItem[]
  courseAccesses UserCourseAccess[]
  inventoryReservation InventoryReservation?
  paymentAttempts PaymentAttempt[]
  commissionEntry CommissionEntry?

  @@index([userId])
  @@index([paymentMarkedPaidBy])
  @@index([createdByAdminId])
  @@index([sellerId, createdAt])
  @@index([status, createdAt])
  @@index([paymentStatus, createdAt])
  @@map("orders")
}

model InventoryReservation {
  id         String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId    String                     @unique @map("order_id") @db.Uuid
  status     InventoryReservationStatus @default(active)
  expiresAt  DateTime                   @map("expires_at") @db.Timestamptz(3)
  consumedAt DateTime?                  @map("consumed_at") @db.Timestamptz(3)
  releasedAt DateTime?                  @map("released_at") @db.Timestamptz(3)
  createdAt  DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(3)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([status, expiresAt])
  @@map("inventory_reservations")
}

model PaymentAttempt {
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId           String          @map("order_id") @db.Uuid
  attemptNumber     Int             @map("attempt_number")
  provider          PaymentProvider @default(mercadopago)
  status            PaymentStatus   @default(pending)
  preferenceId      String?         @unique @map("preference_id") @db.VarChar(100)
  paymentId         String?         @unique @map("payment_id") @db.VarChar(100)
  externalReference String          @unique @map("external_reference") @db.VarChar(100)
  initPoint         String?         @map("init_point") @db.VarChar(1000)
  sandboxInitPoint  String?         @map("sandbox_init_point") @db.VarChar(1000)
  expiresAt         DateTime        @map("expires_at") @db.Timestamptz(3)
  paidAt            DateTime?       @map("paid_at") @db.Timestamptz(3)
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, attemptNumber])
  @@index([orderId, createdAt])
  @@index([status, expiresAt])
  @@map("payment_attempts")
}

model OrderItem {
  id                 String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId            String  @map("order_id") @db.Uuid
  productId          String  @map("product_id") @db.Uuid
  sku                String  @db.VarChar(50)
  nombreProducto     String  @map("nombre_producto") @db.VarChar(255)
  cantidad           Int
  precioUnitario     Decimal @map("precio_unitario") @db.Decimal(12, 2)
  precioBaseSnapshot Decimal @map("precio_base_snapshot") @db.Decimal(12, 2)
  // Costo unitario vigente al crear la orden. NULL = pendiente de costeo (nunca se asume 0).
  costoUnitarioSnapshot Decimal? @map("costo_unitario_snapshot") @db.Decimal(12, 2)
  // Costo total de la línea al consumirse el stock (suma exacta de los lotes FIFO). NULL si no hubo lotes.
  costoTotalSnapshot Decimal? @map("costo_total_snapshot") @db.Decimal(15, 2)
  // 'fifo' = costeada con lotes; 'sin_lote' = se intentó y no había lotes que la cubrieran; NULL = no evaluada.
  costoMetodo String? @map("costo_metodo") @db.VarChar(12)
  descuentoAdicional Decimal @default(0) @map("descuento_adicional") @db.Decimal(5, 2)
  subtotal           Decimal @db.Decimal(15, 2)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
  lotConsumptions LotConsumption[]

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model TierChangeLog {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  oldTier   Tier     @map("old_tier")
  newTier   Tier     @map("new_tier")
  reason    String   @db.VarChar(255)
  changedBy String   @map("changed_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user          User @relation(fields: [userId], references: [id])
  changedByUser User @relation("TierChangeActor", fields: [changedBy], references: [id])

  @@index([userId])
  @@index([changedBy])
  @@map("tier_change_log")
}

model AlegraSyncLog {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entityType      String   @map("entity_type") @db.VarChar(50)
  entityId        String   @map("entity_id") @db.Uuid
  alegraId        String?  @map("alegra_id") @db.VarChar(50)
  action          String   @db.VarChar(50)
  status          String   @db.VarChar(20)
  requestPayload  Json?    @map("request_payload")
  responsePayload Json?    @map("response_payload")
  errorMessage    String?  @map("error_message")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([entityType, entityId])
  @@index([status])
  @@map("alegra_sync_log")
}

model RefreshToken {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  token     String   @unique @db.VarChar(500)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(128)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([usedAt])
  @@map("password_reset_tokens")
}

model SensitiveUserChangeVerification {
  id                String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  targetUserId      String                  @map("target_user_id") @db.Uuid
  requestedByUserId String                  @map("requested_by_user_id") @db.Uuid
  changeType        SensitiveUserChangeType @map("change_type")
  previousValue     String                  @map("previous_value") @db.VarChar(50)
  requestedValue    String                  @map("requested_value") @db.VarChar(50)
  codeHash          String                  @map("code_hash") @db.VarChar(128)
  expiresAt         DateTime                @map("expires_at") @db.Timestamptz(3)
  usedAt            DateTime?               @map("used_at") @db.Timestamptz(3)
  createdAt         DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)

  targetUser      User @relation("SensitiveUserChangeTarget", fields: [targetUserId], references: [id], onDelete: Cascade)
  requestedByUser User @relation("SensitiveUserChangeRequester", fields: [requestedByUserId], references: [id], onDelete: Cascade)

  @@index([targetUserId])
  @@index([requestedByUserId])
  @@index([changeType, expiresAt])
  @@index([usedAt])
  @@map("sensitive_user_change_verifications")
}

model RewardMilestone {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nombre         String   @db.VarChar(255)
  descripcion    String?
  montoRequerido Decimal  @map("monto_requerido") @db.Decimal(15, 2)
  tipo           String   @db.VarChar(50)
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  userRewards UserReward[]

  @@map("reward_milestones")
}

model UserReward {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String       @map("user_id") @db.Uuid
  milestoneId String       @map("milestone_id") @db.Uuid
  status      RewardStatus @default(progressing)
  achievedAt  DateTime?    @map("achieved_at") @db.Timestamptz(3)
  deliveredAt DateTime?    @map("delivered_at") @db.Timestamptz(3)
  deliveredBy String?      @map("delivered_by") @db.Uuid
  notas       String?

  user            User            @relation(fields: [userId], references: [id])
  milestone       RewardMilestone @relation(fields: [milestoneId], references: [id])
  deliveredByUser User?           @relation("RewardDeliverer", fields: [deliveredBy], references: [id], onDelete: SetNull)

  @@unique([userId, milestoneId])
  @@index([milestoneId])
  @@index([deliveredBy])
  @@map("user_rewards")
}

model Catalogo {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  nombre        String    @db.VarChar(255)
  slug          String    @unique @db.VarChar(100)
  activo        Boolean   @default(true)
  configuracion Json      @default("{}")
  deactivatedAt DateTime? @map("deactivated_at") @db.Timestamptz(3)
  deactivatedBy String?   @map("deactivated_by") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user              User               @relation(fields: [userId], references: [id])
  productos         CatalogoProducto[]
  deactivatedByUser User?              @relation("CatalogoDeactivator", fields: [deactivatedBy], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([deactivatedBy])
  @@map("catalogos")
}

model CatalogoProducto {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  catalogoId          String   @map("catalogo_id") @db.Uuid
  productId           String   @map("product_id") @db.Uuid
  precioPersonalizado Decimal? @map("precio_personalizado") @db.Decimal(12, 2)
  orden               Int      @default(0)

  catalogo Catalogo @relation(fields: [catalogoId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id])

  @@unique([catalogoId, productId])
  @@index([productId])
  @@map("catalogo_productos")
}

model Course {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title       String   @db.VarChar(255)
  slug        String   @unique @db.VarChar(255)
  description String?
  imageUrl    String?  @map("image_url") @db.VarChar(500)
  baseTier    Tier     @map("base_tier")
  unlockPrice Decimal  @map("unlock_price") @db.Decimal(12, 2)
  isActive    Boolean  @default(true) @map("is_active")
  order       Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  modules  Module[]
  accesses UserCourseAccess[]

  @@index([isActive, order])
  @@map("courses")
}

model Module {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  courseId    String   @map("course_id") @db.Uuid
  title       String   @db.VarChar(255)
  description String?
  order       Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  course Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  videos Video[]

  @@index([courseId])
  @@map("modules")
}

model Video {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  moduleId      String   @map("module_id") @db.Uuid
  title         String   @db.VarChar(255)
  description   String?
  youtubeUrl    String   @map("youtube_url") @db.VarChar(500)
  duration      Int?
  isFreePreview Boolean  @default(false) @map("is_free_preview")
  order         Int      @default(0)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  module   Module              @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  progress UserVideoProgress[]

  @@index([moduleId])
  @@map("videos")
}

model UserCourseAccess {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  courseId  String   @map("course_id") @db.Uuid
  orderId   String   @map("order_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user   User   @relation(fields: [userId], references: [id])
  course Course @relation(fields: [courseId], references: [id])
  order  Order  @relation(fields: [orderId], references: [id])

  @@unique([userId, courseId])
  @@index([courseId])
  @@index([orderId])
  @@map("user_course_accesses")
}

model UserVideoProgress {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  videoId   String    @map("video_id") @db.Uuid
  watched   Boolean   @default(false)
  watchedAt DateTime? @map("watched_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user  User  @relation(fields: [userId], references: [id])
  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([userId, videoId])
  @@index([videoId])
  @@map("user_video_progresses")
}

model AuditLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String   @db.VarChar(80)
  entityType String   @map("entity_type") @db.VarChar(50)
  entityId   String?  @map("entity_id") @db.VarChar(64)
  before     Json?
  after      Json?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@map("audit_log")
}

enum CommissionStatus {
  accrued
  paid
  voided
}

enum LiquidationStatus {
  pending
  paid
}

// Porcentaje por modalidad. Regla general (userId null) o específica de un comercial.
// Las reglas no se editan: se cierra la vigente (validTo) y se crea otra.
model CommissionRule {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tier       Tier
  userId     String?   @map("user_id") @db.Uuid
  porcentaje Decimal   @db.Decimal(7, 4)
  validFrom  DateTime  @map("valid_from") @db.Timestamptz(3)
  validTo    DateTime? @map("valid_to") @db.Timestamptz(3)
  createdBy  String?   @map("created_by") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tier, userId, validFrom])
  @@map("commission_rules")
}

// Comisión causada de una orden, con instantánea de base y porcentaje.
model CommissionEntry {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId        String           @unique @map("order_id") @db.Uuid
  sellerId       String           @map("seller_id") @db.Uuid
  tier           Tier
  base           Decimal          @db.Decimal(15, 2)
  porcentaje     Decimal          @db.Decimal(7, 4)
  monto          Decimal          @db.Decimal(15, 2)
  ruleId         String?          @map("rule_id") @db.Uuid
  status         CommissionStatus @default(accrued)
  accruedAt      DateTime         @map("accrued_at") @db.Timestamptz(3)
  voidedAt       DateTime?        @map("voided_at") @db.Timestamptz(3)
  liquidationId  String?          @map("liquidation_id") @db.Uuid
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  order       Order                  @relation(fields: [orderId], references: [id])
  seller      User                   @relation(fields: [sellerId], references: [id])
  liquidation CommissionLiquidation? @relation(fields: [liquidationId], references: [id])
  adjustment  CommissionAdjustment?

  @@index([sellerId, status, accruedAt])
  @@index([liquidationId])
  @@map("commission_entries")
}

model CommissionLiquidation {
  id           String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sellerId     String            @map("seller_id") @db.Uuid
  periodFrom   DateTime          @map("period_from") @db.Date
  periodTo     DateTime          @map("period_to") @db.Date
  subtotal     Decimal           @db.Decimal(15, 2)
  ajustes      Decimal           @db.Decimal(15, 2)
  total        Decimal           @db.Decimal(15, 2)
  status       LiquidationStatus @default(pending)
  notas        String?
  createdBy    String?           @map("created_by") @db.Uuid
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  paidAt       DateTime?         @map("paid_at") @db.Timestamptz(3)
  paidBy       String?           @map("paid_by") @db.Uuid

  seller      User                   @relation(fields: [sellerId], references: [id])
  entries     CommissionEntry[]
  adjustments CommissionAdjustment[]

  @@index([sellerId, periodFrom])
  @@index([status])
  @@map("commission_liquidations")
}

// Ajuste manual o automático (reversión por cancelación/reembolso). monto puede ser negativo.
model CommissionAdjustment {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sellerId      String    @map("seller_id") @db.Uuid
  monto         Decimal   @db.Decimal(15, 2)
  motivo        String    @db.VarChar(500)
  entryId       String?   @unique @map("entry_id") @db.Uuid
  liquidationId String?   @map("liquidation_id") @db.Uuid
  createdBy     String?   @map("created_by") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  seller      User                   @relation(fields: [sellerId], references: [id])
  entry       CommissionEntry?       @relation(fields: [entryId], references: [id])
  liquidation CommissionLiquidation? @relation(fields: [liquidationId], references: [id])

  @@index([sellerId, liquidationId])
  @@map("commission_adjustments")
}

// Historial de costos por producto. El costo vigente es la fila más reciente con valid_from <= ahora.
model ProductCost {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId        String   @map("product_id") @db.Uuid
  costoAdquisicion Decimal  @map("costo_adquisicion") @db.Decimal(12, 2)
  costoAdicional   Decimal  @default(0) @map("costo_adicional") @db.Decimal(12, 2)
  costoTotal       Decimal  @map("costo_total") @db.Decimal(12, 2)
  validFrom        DateTime @map("valid_from") @db.Timestamptz(3)
  notas            String?  @db.VarChar(500)
  createdBy        String?  @map("created_by") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  product Product @relation(fields: [productId], references: [id])
  creator User?   @relation(fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([productId, validFrom(sort: Desc)])
  @@map("product_costs")
}

// Categorías de gasto administrables. afectaResultado=false marca conceptos ya contabilizados
// en otro lado (p. ej. flete de compra capitalizado al costo del producto) para no restarlos dos veces.
model ExpenseCategory {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nombre          String   @unique @db.VarChar(120)
  afectaResultado Boolean  @default(true) @map("afecta_resultado")
  isActive        Boolean  @default(true) @map("is_active")
  orden           Int      @default(0)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  expenses Expense[]

  @@map("expense_categories")
}

model Expense {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fecha            DateTime  @db.Date
  descripcion      String    @db.VarChar(500)
  valor            Decimal   @db.Decimal(15, 2)
  categoryId       String    @map("category_id") @db.Uuid
  proveedor        String?   @db.VarChar(255)
  medioPago        String?   @map("medio_pago") @db.VarChar(60)
  observaciones    String?
  soporteReferencia String?  @map("soporte_referencia") @db.VarChar(500)
  createdBy        String?   @map("created_by") @db.Uuid
  voidedAt         DateTime? @map("voided_at") @db.Timestamptz(3)
  voidReason       String?   @map("void_reason") @db.VarChar(500)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  category ExpenseCategory @relation(fields: [categoryId], references: [id])

  @@index([fecha])
  @@index([categoryId, fecha])
  @@map("expenses")
}

enum LotType {
  compra
  valoracion_inicial
}

enum MovementType {
  compra
  valoracion_inicial
  venta
  devolucion
  ajuste
}

// Capa de costo (compra de inventario). Cada lote conserva su costo histórico; el consumo es FIFO.
// 'valoracion_inicial' asigna costo a existencias que ya estaban en bodega y NO suma stock.
model InventoryLot {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId             String   @map("product_id") @db.Uuid
  tipo                  LotType  @default(compra)
  cantidad              Int
  cantidadRestante      Int      @map("cantidad_restante")
  costoUnitario         Decimal  @map("costo_unitario") @db.Decimal(12, 2)
  gastosAdicionales     Decimal  @default(0) @map("gastos_adicionales") @db.Decimal(12, 2)
  costoUnitarioEfectivo Decimal  @map("costo_unitario_efectivo") @db.Decimal(14, 4)
  proveedor             String?  @db.VarChar(255)
  fechaCompra           DateTime @map("fecha_compra") @db.Date
  referencia            String?  @db.VarChar(120)
  observaciones         String?
  claveIdempotencia     String?  @unique @map("clave_idempotencia") @db.VarChar(80)
  createdBy             String?  @map("created_by") @db.Uuid
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  product      Product           @relation(fields: [productId], references: [id])
  consumptions LotConsumption[]
  movements    InventoryMovement[]

  @@index([productId, fechaCompra, createdAt])
  @@map("inventory_lots")
}

// Qué lotes (y a qué costo) consumió cada línea de orden. reversedAt marca la restitución por cancelación.
model LotConsumption {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  lotId       String    @map("lot_id") @db.Uuid
  orderItemId String    @map("order_item_id") @db.Uuid
  cantidad    Int
  costoUnitario Decimal @map("costo_unitario") @db.Decimal(14, 4)
  costoTotal  Decimal   @map("costo_total") @db.Decimal(15, 2)
  reversedAt  DateTime? @map("reversed_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  lot       InventoryLot @relation(fields: [lotId], references: [id])
  orderItem OrderItem    @relation(fields: [orderItemId], references: [id])

  @@unique([lotId, orderItemId])
  @@index([orderItemId])
  @@map("lot_consumptions")
}

// Bitácora de movimientos de costo. cantidad con signo: entradas (+) y salidas (-).
model InventoryMovement {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId   String       @map("product_id") @db.Uuid
  lotId       String?      @map("lot_id") @db.Uuid
  orderItemId String?      @map("order_item_id") @db.Uuid
  tipo        MovementType
  cantidad    Int
  costoUnitario Decimal?   @map("costo_unitario") @db.Decimal(14, 4)
  motivo      String?      @db.VarChar(500)
  createdBy   String?      @map("created_by") @db.Uuid
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  product Product       @relation(fields: [productId], references: [id])
  lot     InventoryLot? @relation(fields: [lotId], references: [id])

  @@index([productId, createdAt])
  @@index([lotId])
  @@map("inventory_movements")
}

// Ajustes administrables (clave/valor) sin tocar código ni variables de entorno.
model AppSetting {
  key       String   @id @db.VarChar(80)
  value     Json
  updatedBy String?  @map("updated_by") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("app_settings")
}
